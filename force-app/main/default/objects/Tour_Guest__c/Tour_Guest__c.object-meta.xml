<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Junction object linking a guest (Person Account) to a Tour booking. One record per guest per tour.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>false</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <label>Tour Guest</label>
    <nameField>
        <label>Tour Guest Name</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
        <displayFormat>TG-{0000000}</displayFormat>
        <startingNumber>1</startingNumber>
    </nameField>
    <pluralLabel>Tour Guests</pluralLabel>
    <searchLayouts/>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
    <fields>
        <fullName>Tour__c</fullName>
        <description>The parent Tour booking record</description>
        <externalId>false</externalId>
        <label>Tour</label>
        <referenceTo>Tour__c</referenceTo>
        <relationshipLabel>Tour Guests</relationshipLabel>
        <relationshipName>Tour_Guests</relationshipName>
        <relationshipOrder>0</relationshipOrder>
        <reparentableMasterDetail>false</reparentableMasterDetail>
        <trackHistory>false</trackHistory>
        <type>MasterDetail</type>
        <writeRequiresMasterRead>false</writeRequiresMasterRead>
    </fields>
    <fields>
        <fullName>Guest__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <description>The guest (Person Account) on this tour</description>
        <externalId>false</externalId>
        <label>Guest</label>
        <referenceTo>Account</referenceTo>
        <relationshipLabel>Tour Guests</relationshipLabel>
        <relationshipName>Tour_Guests</relationshipName>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Is_Primary__c</fullName>
        <defaultValue>false</defaultValue>
        <description>Indicates if this guest is the primary booker</description>
        <externalId>false</externalId>
        <label>Is Primary</label>
        <trackHistory>false</trackHistory>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Check_In_Status__c</fullName>
        <description>Guest check-in status for the tour</description>
        <externalId>false</externalId>
        <label>Check-In Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <type>Picklist</type>
        <valueSet>
            <restricted>false</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value><fullName>Pending</fullName><default>true</default><label>Pending</label></value>
                <value><fullName>Checked In</fullName><default>false</default><label>Checked In</label></value>
                <value><fullName>No Show</fullName><default>false</default><label>No Show</label></value>
                <value><fullName>Cancelled</fullName><default>false</default><label>Cancelled</label></value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Notes__c</fullName>
        <description>Special notes or requirements for this guest on the tour</description>
        <externalId>false</externalId>
        <label>Notes</label>
        <length>500</length>
        <trackHistory>false</trackHistory>
        <type>LongTextArea</type>
        <visibleLines>3</visibleLines>
    </fields>
</CustomObject>
